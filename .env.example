# Sanity — valores públicos (no secretos), necesarios en local y en Vercel.
NEXT_PUBLIC_SANITY_PROJECT_ID=a4kawsmz
NEXT_PUBLIC_SANITY_DATASET=production

# Solo necesario para scripts de escritura (seed, migraciones) — nunca
# expuesto al cliente, nunca con prefijo NEXT_PUBLIC_. Créalo en
# sanity.io/manage → tu proyecto → API → Tokens (permiso "Editor").
SANITY_API_WRITE_TOKEN=

# Necesario para la edición visual (Presentation) y las previsualizaciones
# en borrador: permite leer contenido sin publicar. Créalo en
# sanity.io/manage → tu proyecto → API → Tokens (permiso "Viewer" alcanza;
# "Editor" también sirve). Nunca con prefijo NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=
